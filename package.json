{
  "name": "berkeley-research",
  "private": true,
  "scripts": {
    "test": "node --test",
    "check": "find api engelbart -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium-e2e",
    "test:e2e:round-trip": "playwright test e2e/browser-cli-browser.spec.js --project=chromium-e2e",
    "test:e2e:headed": "playwright test e2e/browser-cli-browser.spec.js --project=chromium-e2e --headed",
    "test:e2e:compat": "playwright test --project=firefox-compat --project=webkit-compat",
    "verify:proxy": "node scripts/verify-proxy.mjs",
    "verify:exhaustion": "node scripts/verify-exhaustion.mjs",
    "verify:pdf": "node scripts/verify-pdf.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0"
  }
}
