    },
    {
      "source": "/engelbart/admin",
      "destination": "/engelbart/admin/index.html"
    },
    {
      "source": "/engelbart/admin/curator",
      "destination": "/engelbart/admin/curator/index.html"
    }
  ],
  "functions": {
    "api/engelbart-setup.js": {
      "maxDuration": 120
    },
    "api/engelbart-curator.js": {
